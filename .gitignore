# Compilación y Salidas (CMake y Qt)
/[Bb]uild/
/cmake-build-*/
/CMakeFiles/
/CMakeCache.txt
/CMakeScripts/
/Makefile
*.cmake
/qmake/

# Archivos de configuración de usuario (Qt Creator y Visual Studio)
*.user
*.user.*
*.suo
*.tasks

